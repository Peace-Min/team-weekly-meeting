<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TeamWeeklyMeeting</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/company.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <SelfContained>false</SelfContained>
    <RuntimeFrameworkVersion>9.0.17</RuntimeFrameworkVersion>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/company-logo.jpg" />
    <Resource Include="Assets/company-mark.png" />
    <Resource Include="Assets/company.ico" />
    <Resource Include="Assets/company-app-icon.png" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <EmbeddedResource Include="../CHANGELOG.md" LogicalName="TeamWeeklyMeeting.Changelog.md" />
  </ItemGroup>
  <Target Name="BuildWindowsInstaller" AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64' and '$(SelfContained)' == 'true' and '$(BuildInstaller)' != 'false'">
    <Message Text="App published. Building the Windows installer with Inno Setup..." Importance="high" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\installer\build-installer.ps1&quot; -SkipPublish -PayloadDir &quot;$(PublishDir).&quot;" />
  </Target>
</Project>
