<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TeamWeeklyMeeting</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/company.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/company-logo.jpg" />
    <Resource Include="Assets/company-mark.png" />
    <Resource Include="Assets/company.ico" />
    <Resource Include="Assets/company-app-icon.png" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
  </ItemGroup>
</Project>
